# ============================================================
# DermaScan — Environment Variables
# Copy this file to .env.local and fill in your values.
# ============================================================

# Supabase — from Settings → API in your Supabase dashboard
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# NOTE: There is NO Gemini key here.
# The Gemini API key lives only as a Supabase secret (FREE):
#   supabase secrets set GEMINI_API_KEY=AIza...
# Get your free key at: https://aistudio.google.com/app/apikey
# Free tier: 15 requests/min, 1,000,000 tokens/day — $0 cost.
